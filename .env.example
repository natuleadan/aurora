# Environment Variables for Natuleadan Aurora (Local & CI Contract)
# Local dev: copy to .env (git-ignored) and populate as needed.
# CI/CD: sync required vars via `gh variable set <KEY> --repo natuleadan/aurora`.

# [var] Renderer environment (development | staging | production)
AURORA_ENV=development
# [var] Enable headless verification mode without display server (1 = enabled)
AURORA_HEADLESS=1
